# AI Control Tower - environment configuration
# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. Set USE_SQLITE=1 to run without PostgreSQL (local checks/tests only).
USE_SQLITE=0
POSTGRES_DB=aig_tower
POSTGRES_USER=aig_tower
POSTGRES_PASSWORD=aig_tower
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=0

# Channel layer for the live execution monitor (WebSockets).
CHANNEL_LAYER_URL=redis://redis:6379/3

# ---------------------------------------------------------------------------
# Provider credentials.
#
# The Control Tower NEVER stores raw provider credentials in the database.
# A Provider record stores only `credential_ref` -- the NAME of the variable
# below. The adapter resolves the real secret at call time.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# IRGF Agent: answers with ChatGPT and its skills when OPENAI_API_KEY is set;
# without a key, or with ASSISTANT_PROVIDER=documentation, it answers from the docs.
ASSISTANT_PROVIDER=openai
ASSISTANT_OPENAI_MODEL=gpt-4o-mini
# ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
# ASSISTANT_OPENAI_KEY_ENV=OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_BEDROCK_ACCESS_KEY=
MISTRAL_API_KEY=
